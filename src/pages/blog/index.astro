---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString("tr-TR", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title="Blog | Rahimoff Nail Studio"
  description="Manikür, pedikür, tırnak bakımı ve nail art hakkında Rahimoff Nail Studio uzmanlarından ipuçları ve yazılar."
  path="/blog"
  noindex={posts.length === 0}
>
  <section class="mx-auto max-w-[1100px] px-5 pb-24 pt-32 md:pt-40">
    <header class="mb-12 max-w-[640px]">
      <p class="mb-3 text-[11px] uppercase tracking-[0.2em] text-burgundy-500" style="font-family: Manrope, sans-serif">Blog</p>
      <h1 class="text-4xl text-charcoal-900 md:text-5xl" style="font-family: 'Cormorant Garamond', serif">Tırnak bakımı üzerine yazılar</h1>
      <p class="mt-4 text-charcoal-700" style="font-family: Manrope, sans-serif">
        Uzmanlarımızdan manikür, pedikür ve nail art hakkında ipuçları.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-charcoal-700" style="font-family: Manrope, sans-serif">Yakında burada yazılarımızı bulabilirsiniz.</p>
      ) : (
        <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li class="group border border-[#e6e0d0] bg-white transition-colors hover:border-[#d8c9a8]">
              <a href={`/blog/${post.id}`} class="flex h-full flex-col">
                {post.data.cover && (
                  <Image src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} widths={[400, 700]} sizes="(min-width: 1024px) 340px, (min-width: 768px) 45vw, 100vw" class="aspect-[4/3] w-full object-cover" />
                )}
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <time class="text-[11px] uppercase tracking-[0.14em] text-[#8a7b6a]" style="font-family: Manrope, sans-serif" datetime={post.data.pubDate.toISOString()}>
                    {fmt(post.data.pubDate)}
                  </time>
                  <h2 class="text-2xl leading-snug text-charcoal-900" style="font-family: 'Cormorant Garamond', serif">{post.data.title}</h2>
                  <p class="text-[14px] leading-relaxed text-charcoal-700" style="font-family: Manrope, sans-serif">{post.data.description}</p>
                  <span class="mt-auto pt-3 text-[13px] font-medium text-burgundy-500" style="font-family: Manrope, sans-serif">Devamını oku →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
