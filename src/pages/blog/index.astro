---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { getPublishedPosts } from "../../lib/blog";

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Rahimoff Nail Studio Blog",
    url: new URL("/blog", Astro.site).href,
    inLanguage: "tr",
  },
];
---

<BaseLayout
  title="Blog | Rahimoff Nail Studio"
  description="Manikür, pedikür, tırnak bakımı ve nail art hakkında Rahimoff Nail Studio uzmanlarından ipuçları ve yazılar."
  path="/blog"
  noindex={posts.length === 0}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-[1140px] px-5 pb-24 pt-32 md:px-8 md:pt-40">
    <header class="mb-12 max-w-[680px]">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-burgundy-500" style="font-family: Manrope, sans-serif">Blog</p>
      <h1 class="text-4xl leading-tight text-charcoal-900 md:text-6xl" style="font-family: 'Cormorant Garamond', serif">
        Tırnak bakımı üzerine yazılar
      </h1>
      <p class="mt-5 text-[16px] leading-relaxed text-charcoal-700" style="font-family: Manrope, sans-serif">
        Manikür, pedikür ve nail art hakkında uzmanlarımızdan pratik bilgiler ve ilham.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-charcoal-700" style="font-family: Manrope, sans-serif">Yakında burada yazılarımızı bulabilirsiniz.</p>
      ) : (
        <div class="flex flex-col gap-8">
          {featured && <BlogCard post={featured} featured />}
          {
            rest.length > 0 && (
              <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {rest.map((post) => (
                  <li>
                    <BlogCard post={post} />
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      )
    }
  </section>
</BaseLayout>
