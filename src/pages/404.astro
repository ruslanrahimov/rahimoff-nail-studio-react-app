---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Sayfa bulunamadı | Rahimoff Nail Studio" description="Aradığınız sayfa bulunamadı." path="/404" noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center gap-6 px-6 py-32 text-center">
    <p class="text-sm uppercase tracking-[0.2em] text-burgundy-500" style="font-family: Manrope, sans-serif">404</p>
    <h1 class="text-4xl text-charcoal-900" style="font-family: 'Cormorant Garamond', serif">Sayfa bulunamadı</h1>
    <p class="text-charcoal-700" style="font-family: Manrope, sans-serif">
      Aradığınız sayfa taşınmış ya da kaldırılmış olabilir.
    </p>
    <a href="/" class="border border-burgundy-500 px-8 py-3 text-[13px] uppercase tracking-wider text-burgundy-500 transition hover:bg-burgundy-500 hover:text-white" style="font-family: Manrope, sans-serif">Ana sayfaya dön</a>
  </section>
</BaseLayout>
